---
import { Image } from 'astro:assets';
import memoji from '../assets/memoji.png';
---

<section class="hero">
  <div class="wrap">
    <div class="row">
      <div class="terminal">
        <div class="titlebar">
          <span class="dots" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span class="path">michael@mezgolits.at: ~</span>
        </div>
        <div class="body">
          <p class="cmd">
            <span class="prompt" aria-hidden="true">
              $
            </span>{' '}
            whoami
          </p>
          <h1>Michael Mezgolits</h1>
          <p class="cmd">
            <span class="prompt" aria-hidden="true">
              $
            </span>{' '}
            cat role.txt
          </p>
          <p class="out">Software Engineering Student · Junior Researcher</p>
          <p class="cmd">
            <span class="prompt" aria-hidden="true">
              $
            </span>{' '}
            <span class="cursor" aria-hidden="true"></span>
          </p>
        </div>
      </div>
      <Image
        class="memoji"
        src={memoji}
        alt="Memoji portrait of Michael"
        width={220}
        height={220}
      />
    </div>
    <div class="actions">
      <a class="btn btn-primary" href="#projects">
        View projects
      </a>
      <a class="btn btn-outline" href="#contact">
        Contact
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 96px 0 112px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
  }
  .terminal {
    flex: 1 1 360px;
    max-width: 640px;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    font-family: var(--mono), monospace;
    font-size: 13px;
    color: var(--muted);
  }
  .dots {
    display: flex;
    gap: 8px;
  }
  .dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #3a3f44;
  }
  @media (prefers-color-scheme: light) {
    .dots i {
      background: #c9c7c0;
    }
  }
  .body {
    padding: 24px 20px;
    font-family: var(--mono), monospace;
    font-size: 15px;
  }
  .body p {
    margin: 0;
  }
  .cmd {
    color: var(--muted);
  }
  .prompt {
    color: var(--accent);
  }
  h1 {
    margin: 8px 0 24px;
    font-family: var(--sans), sans-serif;
    font-size: clamp(30px, 6vw, 52px);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .body .out {
    margin: 8px 0 24px;
    font-family: var(--sans), sans-serif;
    font-size: 18px;
    color: var(--text);
  }
  .cursor {
    display: inline-block;
    width: 9px;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .memoji {
    flex: 0 0 auto;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    object-fit: cover;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 40px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding: 0 24px;
    border-radius: 8px;
    border: 1px solid var(--accent);
    text-decoration: none;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--bg);
  }
  .btn-outline {
    color: var(--accent);
  }
  .btn-outline:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
