---
import Mail from './Mail.astro';
---

<section class="section" id="contact">
  <div class="wrap">
    <h2 class="section-title">Contact</h2>
    <p class="link">
      <Mail />
    </p>
    <p class="link">
      <a href="https://github.com/michael-mezgo" rel="noreferrer">
        GitHub
      </a>
    </p>
  </div>
</section>

<style>
  .link {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    margin: 0;
  }
</style>
